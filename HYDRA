    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

        /* =================================================
           CONFIGURACIÓN
        ================================================== */

        // Capacidad propuesta para Hydra Smart:
        // 750 ml = 0.75 litros

        const BOTTLE_CAPACITY_LITERS = 0.75;


        /* =================================================
           1. CALCULADORA DE HIDRATACIÓN
        ================================================== */

        const hydrationForm =
            document.getElementById("hydrationForm");

        const hydrationResult =
            document.getElementById("hydrationResult");

        const waterResult =
            document.getElementById("waterResult");

        const fillResult =
            document.getElementById("fillResult");


        hydrationForm.addEventListener("submit", function(event) {

            event.preventDefault();


            // Obtener datos

            const weight =
                parseFloat(
                    document.getElementById("weight").value
                );

            const activity =
                parseFloat(
                    document.getElementById("activity").value
                );


            // Validación

            if (
                isNaN(weight) ||
                weight <= 0 ||
                isNaN(activity)
            ) {

                alert(
                    "Por favor, completa correctamente tus datos."
                );

                return;
            }


            /*
             * Fórmula orientativa:
             *
             * 35 ml de agua por cada kg de peso
             *
             * + ajuste según nivel de actividad.
             *
             * El resultado se convierte a litros.
             */

            const baseWater =
                weight * 0.035;

            const dailyWater =
                baseWater + activity;


            // Calcular cantidad de llenados

            const bottleFills =
                dailyWater / BOTTLE_CAPACITY_LITERS;


            // Redondear resultados

            const roundedWater =
                dailyWater.toFixed(2);

            const roundedFills =
                Math.ceil(bottleFills);


            // Mostrar resultados

            waterResult.textContent =
                `${roundedWater} L`;

            fillResult.textContent =
                `≈ ${roundedFills} llenados de Hydra Smart de 750 ml`;


            hydrationResult.classList.add("active");

        });


        /* =================================================
           2. NOTIFICACIONES DEL NAVEGADOR
        ================================================== */

        const notificationButton =
            document.getElementById("notificationButton");

        const notificationStatus =
            document.getElementById("notificationStatus");


        notificationButton.addEventListener(
            "click",
            async function() {

                // Verificar compatibilidad

                if (!("Notification" in window)) {

                    notificationStatus.textContent =
                        "Tu navegador no admite notificaciones.";

                    return;
                }


                try {

                    const permission =
                        await Notification.requestPermission();


                    if (permission === "granted") {

                        notificationStatus.textContent =
                            "¡Recordatorios activados! 💧";

                        notificationButton.textContent =
                            "Activado";

                        notificationButton.disabled =
                            true;


                        // Notificación de prueba

                        new Notification(
                            "Hydra Smart 💧",
                            {
                                body:
                                    "¡Es momento de hidratarte!"
                            }
                        );

                    }

                    else if (permission === "denied") {

                        notificationStatus.textContent =
                            "Las notificaciones están bloqueadas en tu navegador.";

                    }

                    else {

                        notificationStatus.textContent =
                            "Puedes activar los recordatorios cuando quieras.";

                    }

                }

                catch (error) {

                    notificationStatus.textContent =
                        "No fue posible activar las notificaciones.";

                    console.error(error);

                }

            }
        );


        /* =================================================
           3. ACORDEÓN GUÍA MODULAR
        ================================================== */

        const accordionHeaders =
            document.querySelectorAll(
                ".accordion-header"
            );


        accordionHeaders.forEach(function(header) {

            header.addEventListener(
                "click",
                function() {

                    const item =
                        header.parentElement;


                    // Cerrar otros elementos

                    document
                        .querySelectorAll(".accordion-item")
                        .forEach(function(otherItem) {

                            if (otherItem !== item) {

                                otherItem.classList.remove(
                                    "active"
                                );

                            }

                        });


                    // Abrir/cerrar actual

                    item.classList.toggle("active");

                }
            );

        });


        /* =================================================
           4. CTA HYDRA TRIBE
        ================================================== */

        const joinCommunity =
            document.getElementById("joinCommunity");


        joinCommunity.addEventListener(
            "click",
            function(event) {

                event.preventDefault();


                alert(
                    "¡Bienvenido a Hydra Tribe! 💧"
                );

            }
        );


        /* =================================================
           5. MENSAJE INICIAL EN CONSOLA
        ================================================== */

        console.log(
            "Hydra Smart Web App iniciada correctamente."
        );

    </script>

</body>
