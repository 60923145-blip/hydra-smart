<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Hydra Smart | Hidratación Inteligente</title>

    <meta
        name="description"
        content="Hydra Smart: hidrátate mejor, personaliza tu botella y forma parte de Hydra Tribe."
    >

    <style>
        /* =====================================================
           1. VARIABLES Y CONFIGURACIÓN GENERAL
        ====================================================== */

        :root {
            --aqua: #21c7c9;
            --aqua-dark: #119fa5;
            --aqua-light: #e9fbfb;

            --charcoal: #263238;
            --gray: #607078;
            --light-gray: #f4f7f8;

            --white: #ffffff;
            --border: #dce7e9;

            --radius: 18px;
            --shadow: 0 8px 25px rgba(38, 50, 56, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background: var(--light-gray);
            color: var(--charcoal);
            line-height: 1.5;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        /* =====================================================
           2. HEADER / NAVEGACIÓN
        ====================================================== */

        header {
            position: sticky;
            top: 0;
            z-index: 100;

            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);

            border-bottom: 1px solid var(--border);
        }

        .navbar {
            max-width: 900px;
            margin: auto;

            padding: 15px 20px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--charcoal);
        }

        .logo span {
            color: var(--aqua-dark);
        }

        .nav-link {
            text-decoration: none;
            color: var(--gray);
            font-size: 0.85rem;
            font-weight: 600;
        }

        /* =====================================================
           3. CONTENEDOR PRINCIPAL
        ====================================================== */

        main {
            max-width: 900px;
            margin: auto;
            padding: 20px;
        }

        section {
            margin-bottom: 28px;
            scroll-margin-top: 80px;
        }

        .section-title {
            font-size: 1.55rem;
            margin-bottom: 8px;
        }

        .section-description {
            color: var(--gray);
            margin-bottom: 18px;
            font-size: 0.95rem;
        }

        /* =====================================================
           4. HERO / BIENVENIDA
        ====================================================== */

        .hero {
            background: var(--charcoal);
            color: var(--white);

            border-radius: 25px;

            padding: 35px 25px;

            position: relative;
            overflow: hidden;

            margin-bottom: 25px;
        }

        .hero::after {
            content: "";
            position: absolute;

            width: 180px;
            height: 180px;

            border-radius: 50%;

            background: var(--aqua);

            right: -70px;
            top: -70px;

            opacity: 0.25;
        }

        .hero-badge {
            display: inline-block;

            background: rgba(33, 199, 201, 0.15);
            color: var(--aqua);

            padding: 6px 12px;
            border-radius: 50px;

            font-size: 0.78rem;
            font-weight: 700;

            margin-bottom: 15px;
        }

        .hero h1 {
            font-size: clamp(2rem, 8vw, 3.4rem);
            line-height: 1.05;

            max-width: 650px;

            margin-bottom: 15px;
        }

        .hero h1 span {
            color: var(--aqua);
        }

        .hero p {
            color: #d7e1e3;
            max-width: 600px;
        }

        /* =====================================================
           5. TARJETAS
        ====================================================== */

        .card {
            background: var(--white);

            border: 1px solid var(--border);
            border-radius: var(--radius);

            padding: 22px;

            box-shadow: var(--shadow);
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
        }

        /* =====================================================
           6. CALCULADORA
        ====================================================== */

        .form-group {
            margin-bottom: 17px;
        }

        label {
            display: block;

            font-size: 0.9rem;
            font-weight: 700;

            margin-bottom: 7px;
        }

        input,
        select {
            width: 100%;

            padding: 14px;

            border: 1px solid var(--border);
            border-radius: 12px;

            outline: none;

            color: var(--charcoal);
            background: var(--white);
        }

        input:focus,
        select:focus {
            border-color: var(--aqua);
            box-shadow: 0 0 0 3px rgba(33, 199, 201, 0.12);
        }

        .primary-button {
            width: 100%;

            border: none;
            border-radius: 12px;

            padding: 14px 18px;

            background: var(--aqua);
            color: var(--charcoal);

            font-weight: 800;

            transition: 0.2s ease;
        }

        .primary-button:hover {
            background: var(--aqua-dark);
            color: var(--white);
            transform: translateY(-1px);
        }

        /* =====================================================
           7. RESULTADO HIDRATACIÓN
        ====================================================== */

        .hydration-result {
            margin-top: 18px;

            background: var(--aqua-light);

            border-radius: 15px;

            padding: 20px;

            display: none;
        }

        .hydration-result.active {
            display: block;
        }

        .result-number {
            font-size: 2.2rem;
            font-weight: 900;

            color: var(--aqua-dark);
        }

        .result-label {
            color: var(--gray);
            font-size: 0.88rem;
        }

        .fill-result {
            margin-top: 12px;

            font-weight: 700;
        }

        /* =====================================================
           8. RECORDATORIOS
        ====================================================== */

        .notification-box {
            display: flex;
            align-items: center;
            gap: 15px;

            background: var(--white);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            padding: 20px;

            box-shadow: var(--shadow);
        }

        .notification-icon {
            min-width: 50px;
            height: 50px;

            display: grid;
            place-items: center;

            border-radius: 50%;

            background: var(--aqua-light);

            font-size: 1.5rem;
        }

        .notification-content {
            flex: 1;
        }

        .notification-content h3 {
            font-size: 1rem;
            margin-bottom: 3px;
        }

        .notification-content p {
            color: var(--gray);
            font-size: 0.82rem;
        }

        .small-button {
            border: none;

            background: var(--charcoal);
            color: var(--white);

            padding: 10px 14px;

            border-radius: 10px;

            font-size: 0.8rem;
            font-weight: 700;
        }

        /* =====================================================
           9. RECETAS - HACKÉA TU AGUA
        ====================================================== */

        .recipe-card {
            overflow: hidden;
        }

        .recipe-icon {
            height: 90px;

            display: grid;
            place-items: center;

            background: var(--aqua-light);

            font-size: 2.5rem;

            border-radius: 13px;

            margin-bottom: 15px;
        }

        .recipe-card h3 {
            margin-bottom: 7px;
        }

        .recipe-card p {
            color: var(--gray);
            font-size: 0.88rem;
        }

        .recipe-tag {
            display: inline-block;

            margin-top: 12px;

            font-size: 0.75rem;
            font-weight: 700;

            color: var(--aqua-dark);
        }

        /* =====================================================
           10. HYDRA TRIBE
        ====================================================== */

        .tribe {
            background: var(--aqua);

            color: var(--charcoal);

            border-radius: 22px;

            padding: 28px 22px;

            position: relative;
            overflow: hidden;
        }

        .tribe h2 {
            font-size: 1.8rem;
            margin-bottom: 8px;
        }

        .tribe p {
            max-width: 600px;
            margin-bottom: 18px;
        }

        .cta-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .cta-button {
            display: inline-block;

            text-align: center;
            text-decoration: none;

            padding: 13px 18px;

            border-radius: 11px;

            background: var(--charcoal);
            color: var(--white);

            font-weight: 800;

            transition: 0.2s ease;
        }

        .cta-button:hover {
            transform: translateY(-2px);
        }

        .cta-secondary {
            background: var(--white);
            color: var(--charcoal);
        }

        /* =====================================================
           11. ACORDEÓN GUÍA MODULAR
        ====================================================== */

        .accordion {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .accordion-item {
            background: var(--white);

            border: 1px solid var(--border);

            border-radius: 14px;

            overflow: hidden;
        }

        .accordion-header {
            width: 100%;

            background: none;
            border: none;

            padding: 17px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            text-align: left;

            color: var(--charcoal);

            font-weight: 800;
        }

        .accordion-icon {
            color: var(--aqua-dark);
            font-size: 1.2rem;

            transition: transform 0.2s ease;
        }

        .accordion-content {
            max-height: 0;
            overflow: hidden;

            padding: 0 17px;

            color: var(--gray);

            font-size: 0.9rem;

            transition: max-height 0.3s ease, padding 0.3s ease;
        }

        .accordion-item.active .accordion-content {
            max-height: 200px;
            padding: 0 17px 17px;
        }

        .accordion-item.active .accordion-icon {
            transform: rotate(45deg);
        }

        /* =====================================================
           12. FOOTER
        ====================================================== */

        footer {
            text-align: center;

            padding: 30px 20px;

            color: var(--gray);

            font-size: 0.8rem;
        }

        footer strong {
            color: var(--aqua-dark);
        }

        /* =====================================================
           13. RESPONSIVE
        ====================================================== */

        @media (min-width: 650px) {

            main {
                padding: 35px 25px;
            }

            .grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .cta-group {
                flex-direction: row;
            }

            .cta-button {
                min-width: 180px;
            }

            .notification-box {
                padding: 24px;
            }
        }
    </style>
</head>


